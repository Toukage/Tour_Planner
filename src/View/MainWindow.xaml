<Window x:Class="TourPlanner.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TourPlanner.View"
        xmlns:s="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="Tour Planner" 
        Height="600" Width="1000" 
        MinWidth="800" MinHeight="500" 
        ResizeMode="CanResize">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition  Width="Auto" MinWidth="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Tour Planner" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" Foreground="DarkOrchid"/>
            <local:TourListView Grid.Row="1" DataContext="{Binding TourListVM}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>

        <Grid Grid.Column="1" Margin="10">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TabControl Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <TabItem Header="Map">
                    <local:MapView x:Name="MapHost" MinHeight="200" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GeoJson="{Binding DataContext.MapVM.CurrentRouteGeoJson, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </TabItem>


                <TabItem Header="Details">
                    <local:TourDetailsView DataContext="{Binding DetailsVM}" MinHeight="200" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </TabItem>
                
            </TabControl>
            <local:LogListView Grid.Row="1" DataContext="{Binding LogListVM}" MinHeight="120" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            
        </Grid>
    </Grid>
</Window>
