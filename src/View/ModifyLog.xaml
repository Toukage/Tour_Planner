<Window x:Class="TourPlanner.View.ModifyLog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourPlanner.View"
        mc:Ignorable="d"
        Title="Modify Log" Height="420" Width="420">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="4">
            <TextBlock Text="Date ; Time"/>
            <DatePicker SelectedDate="{Binding Log.LogDate, Mode=TwoWay}"/>
            <TextBox Margin="0,4,0,0" Text="{Binding Log.LogDate, Mode=TwoWay, StringFormat={}{0:t}, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type time (HH:mm) after picking a date"/>

            <TextBlock Margin="8,10,0,0" Text="Comment"/>
            <TextBox Text="{Binding Log.LogComment, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="8,10,0,0" Text="Difficulty (1-5)"/>
            <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Log.LogDifficulty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="8,10,0,0" Text="Total Distance (km)"/>
            <TextBox Text="{Binding LogDistance, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="8,10,0,0" Text="Total Time (min)"/>
           <TextBox Text="{Binding LogTime, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="8,10,0,0" Text="Rating (1-5)"/>
            <Slider Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Log.Rating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
            <Button Content="Save"   Width="90" Margin="0,0,20,0" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" Width="90" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>

</Window>