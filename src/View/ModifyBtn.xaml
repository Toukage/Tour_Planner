<UserControl x:Class="TourPlanner.View.ModifyBtn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TourPlanner.View">
    <Button Content="⚙" Padding="8,2"
            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Command}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=CommandParameter}"
            IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsButtonEnabled}"/>
</UserControl>
