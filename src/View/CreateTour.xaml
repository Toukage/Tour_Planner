<Window x:Class="TourPlanner.View.CreateTour"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TourPlanner.View"
        Title="Create New Tour"
        Height="560" Width="500"
        MinHeight="360" MinWidth="420"
        ResizeMode="CanResize">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tour Name:" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="0" Margin="2" Text="{Binding Tour.TourName, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Text="Start Location:" Margin="5"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="2" Text="{Binding Tour.TourStart, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="1" Text="End Location:" Margin="5"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="2" Text="{Binding Tour.TourEnd, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="6" Grid.Column="1" Text="Description:" Margin="5"/>
            <TextBox Grid.Row="7" Grid.Column="1" Margin="2" Text="{Binding Tour.TourDescription, UpdateSourceTrigger=PropertyChanged}"/>
        
            <TextBlock Grid.Row="8" Grid.Column="1" Text="Transport:" Margin="5"/>

            <ComboBox Grid.Row="9" Grid.Column="1" SelectedValuePath="Content" Margin="2" SelectedValue="{Binding Tour.Transport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="Car"/>
                <ComboBoxItem Content="Bike"/>
                <ComboBoxItem Content="Walking"/>
                <ComboBoxItem Content="Public Transport"/>
            </ComboBox>

            <Button Grid.Row="10" Grid.Column="1" Content="Create Tour" Width="120" Margin="10" Command="{Binding CreateTourCommand}"/>
        </Grid>
    </ScrollViewer>
</Window>
