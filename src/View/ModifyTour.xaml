<Window x:Class="TourPlanner.View.ModifyTour"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modify Tour"
        Height="560" Width="500"
        MinHeight="320" MinWidth="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tour Name:" Margin="5"/>
        <TextBox Grid.Row="1" Margin="2" Text="{Binding TourName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Text="Start Location:" Margin="5"/>
        <TextBox Grid.Row="3" Margin="2" Text="{Binding TourStart, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Text="End Location:" Margin="5"/>
        <TextBox Grid.Row="5" Margin="2" Text="{Binding TourEnd, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="6" Text="Description:" Margin="5"/>
        <TextBox   Grid.Row="7" Margin="2" Text="{Binding TourDescription, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="8" Text="Transport:" Margin="5"/>
        <ComboBox Grid.Row="9" SelectedValuePath="Content" Margin="2" SelectedValue="{Binding Transport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <ComboBoxItem Content="Car"/>
            <ComboBoxItem Content="Bike"/>
            <ComboBoxItem Content="Walking"/>
            <ComboBoxItem Content="Public Transport"/>
        </ComboBox>

        <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save"   Command="{Binding SaveCommand}"   MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
